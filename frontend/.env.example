# Copy to .env and adjust. Only VITE_-prefixed keys reach the browser.
#
# There are two separate settings because dev and production reach the backend
# in different ways. Most setups only need the first.

# --- Development ----------------------------------------------------------
# Where `npm run dev` proxies /api and /media. Used by vite.config.ts only;
# it is never baked into the built bundle.
VITE_API_TARGET=http://127.0.0.1:8000

# --- Production -----------------------------------------------------------
# Leave EMPTY when the frontend and API are served from the same origin — i.e.
# your reverse proxy forwards /api and /media to the backend. This is the
# recommended setup: no CORS, and media URLs work unchanged.
#
# Set it to the API's absolute origin only when the two are on different hosts
# (e.g. site on Vercel, API on a VPS). It is baked in at build time, so you
# must rebuild after changing it — and the origin below must also appear in
# CORS_ORIGINS in backend/.env.
#
# VITE_API_BASE_URL=https://api.peterandyvette.rw
VITE_API_BASE_URL=
