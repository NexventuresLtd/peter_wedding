# Copy to .env and adjust. Only VITE_-prefixed keys reach the browser.
#
# IMPORTANT: these are baked into the bundle by `npm run build`. Editing .env
# on a deployed server changes nothing until you rebuild and redeploy dist/.

# --- Development ----------------------------------------------------------
# Where `npm run dev` proxies API traffic. Used by vite.config.ts only, and
# never baked into the build.
VITE_API_TARGET=http://127.0.0.1:8000

# --- Where the API lives --------------------------------------------------
# Prefix placed in front of every request, and in front of every media URL.
# It must match API_PREFIX in backend/.env.
#
#   unset            -> "/api"   (dev, and same-origin deploys via a proxy)
#   "/api/v1"        -> same origin, API published under a path
#   "https://api.example.com/api/v1" -> API on a separate host (also add this
#                       site's origin to CORS_ORIGINS in backend/.env)
#
# Example for https://peterandyvette.com with the API at /api/v1:
# VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=
