# --- Database -------------------------------------------------------------
# Database name is fixed to peterwedding. Fill in your Postgres user/password.
DATABASE_URL=postgresql+psycopg://postgres:YourStrongPassword@127.0.0.1:5432/peterwedding

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- First admin (seeded once by `python -m app.seed`) ---------------------
FIRST_ADMIN_EMAIL=admin@peterwedding.rw
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Wedding Admin

# --- App ------------------------------------------------------------------
# Path that every endpoint and the media mount live under. Whatever you set
# here, the frontend's VITE_API_BASE_URL must end with the same path.
#   /api        -> https://example.com/api/site
#   /api/v1     -> https://example.com/api/v1/site
# Your reverse proxy must forward this path WITHOUT stripping it.
API_PREFIX=/api

# Public base URL of the frontend — this is what the QR code points to.
# Blank = derive from the incoming request (recommended: the deployed domain
# is then always correct). Set it only to force a specific origin.
PUBLIC_SITE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_IMAGE_MB=15
MAX_VIDEO_MB=200
